{
  "name": "ariadne-nsd",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps && pnpm test && pnpm test-list:check",
    "coverage": "node scripts/coverage.mjs",
    "test-list": "node scripts/test-list.mjs",
    "test-list:check": "node scripts/test-list.mjs --check",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise apps packages",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @ariadne-nsd/web e2e",
    "dev": "pnpm --filter @ariadne-nsd/web dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
