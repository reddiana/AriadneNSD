{
  "name": "@ariadne-nsd/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./pdf/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p node/tsconfig.json",
    "test": "vitest run",
    "golden:update": "vitest run node/golden.test.ts node/export-golden.test.ts -u -t \"is saved as the golden file\" && vitest run node/golden.test.ts node/export-golden.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ariadne-nsd/fonts": "workspace:*"
  }
}
