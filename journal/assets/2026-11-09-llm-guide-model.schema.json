{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadnensd.com/model.schema.json",
  "title": "AriadneNSD model JSON, format version 1",
  "description": "Draft for M56 (2026-11-09), written from docs/05-spec/01-file-format.md 3.3 and core's parseModel. The schema checks the shape only; the app also checks the invariants: every id once, a local call names a Method diagram, fold ends in their sequence, no blank diagram among several.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "settings", "diagrams", "view"],
  "properties": {
    "format": { "const": "ariadne-nsd" },
    "version": { "const": 1 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKind", "theme", "headStyle"],
      "properties": {
        "textKind": { "enum": ["plain", "c", "cpp", "java", "javascript", "python", "bash"] },
        "theme": { "enum": ["default", "dark", "high-contrast", "print"] },
        "headStyle": { "enum": ["shape", "title"] },
        "locale": { "enum": ["en", "ko"] },
        "textOutlines": { "const": true }
      }
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "body"],
        "properties": {
          "id": { "$ref": "#/$defs/diagramId" },
          "head": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": { "enum": ["event", "method"] },
              "text": { "type": "string" }
            }
          },
          "body": { "$ref": "#/$defs/body" },
          "folds": { "$ref": "#/$defs/folds" }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folded", "opened", "bands", "resultSymbol"],
      "properties": {
        "folded": { "type": "array", "items": { "type": "string" } },
        "opened": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/blockId" } } },
        "bands": { "type": "boolean" },
        "resultSymbol": { "enum": ["←", "="] }
      }
    }
  },
  "$defs": {
    "diagramId": { "type": "string", "pattern": "^d[1-9][0-9]*$" },
    "blockId": { "type": "string", "pattern": "^b[1-9][0-9]*$" },
    "branchId": { "type": "string", "pattern": "^r[1-9][0-9]*$" },
    "foldId": { "type": "string", "pattern": "^f[1-9][0-9]*$" },
    "body": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
    "folds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "first", "last"],
        "properties": {
          "id": { "$ref": "#/$defs/foldId" },
          "first": { "$ref": "#/$defs/blockId" },
          "last": { "$ref": "#/$defs/blockId" },
          "name": { "type": "string" }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/branchId" },
        "label": { "type": "string" },
        "body": { "$ref": "#/$defs/body" },
        "folds": { "$ref": "#/$defs/folds" }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/branchId" },
        "label": { "type": "string" },
        "body": { "$ref": "#/$defs/body" },
        "folds": { "$ref": "#/$defs/folds" }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "text"],
          "properties": {
            "id": { "$ref": "#/$defs/blockId" },
            "kind": { "const": "process" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "text", "yes", "no"],
          "properties": {
            "id": { "$ref": "#/$defs/blockId" },
            "kind": { "const": "if" },
            "text": { "type": "string" },
            "yes": { "$ref": "#/$defs/branch" },
            "no": { "$ref": "#/$defs/branch" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "text", "arms"],
          "properties": {
            "id": { "$ref": "#/$defs/blockId" },
            "kind": { "const": "case" },
            "text": { "type": "string" },
            "arms": { "type": "array", "items": { "$ref": "#/$defs/arm" } },
            "otherwise": { "$ref": "#/$defs/branch" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "text", "body"],
          "properties": {
            "id": { "$ref": "#/$defs/blockId" },
            "kind": { "enum": ["while", "doWhile", "for"] },
            "text": { "type": "string" },
            "body": { "$ref": "#/$defs/body" },
            "folds": { "$ref": "#/$defs/folds" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "target", "args", "result"],
          "properties": {
            "id": { "$ref": "#/$defs/blockId" },
            "kind": { "const": "call" },
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "diagram"],
                  "properties": { "kind": { "const": "local" }, "diagram": { "$ref": "#/$defs/diagramId" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "name"],
                  "properties": { "kind": { "const": "named" }, "name": { "type": "string" } }
                }
              ]
            },
            "args": { "type": "string" },
            "result": { "type": "string" }
          }
        }
      ]
    }
  }
}
