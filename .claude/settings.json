{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/co-change-commit.mjs\"",
            "timeout": 30,
            "statusMessage": "함께 바뀌는 곳의 검사"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc-check.py\"",
            "timeout": 30,
            "statusMessage": "문서 검사"
          }
        ]
      }
    ]
  }
}
