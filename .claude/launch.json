{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "src",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "site/.quartz/public",
        "-l",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "gallery",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "src/apps/gallery/dist",
        "-l",
        "8095"
      ],
      "port": 8095
    }
  ]
}
